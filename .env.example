# Copy to .env at repository root. Never commit .env.
# Get a key from your own AI provider account; this app currently implements OpenAI.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DATABASE_URL=sqlite:///./clinical.db
ENVIRONMENT=development
APP_ORIGIN=http://127.0.0.1:8000
MAX_PENDING_JOBS=8
SUBMISSIONS_PER_HOUR=10
GLOBAL_SUBMISSIONS_PER_HOUR=50
JOB_TIMEOUT_SECONDS=300
